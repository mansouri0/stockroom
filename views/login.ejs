<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Sign in | Stockroom</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/styles.css" rel="stylesheet"></head>
<body class="d-flex align-items-center min-vh-100"><main class="container"><div class="row justify-content-center"><div class="col-sm-9 col-md-6 col-lg-4"><div class="card border-0 shadow-sm"><form method="post" action="/login" class="card-body p-4"><h1 class="h3 mb-1">Stockroom</h1><p class="text-secondary mb-4">Sign in to manage inventory.</p><% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %><label for="password" class="form-label">Administrator password</label><input class="form-control" id="password" name="password" type="password" autocomplete="current-password" required autofocus><button class="btn btn-primary w-100 mt-4">Sign in</button></form></div></div></div></main></body></html>
