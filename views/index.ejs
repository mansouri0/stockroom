<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Stockroom | Inventory Tracker</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"><link href="/styles.css" rel="stylesheet"></head>
<body>
  <nav class="navbar navbar-dark bg-primary shadow-sm"><div class="container py-1"><a class="navbar-brand fw-bold" href="/"><i class="bi bi-box-seam-fill me-2"></i>Stockroom</a><div class="d-flex align-items-center gap-3"><a class="nav-link text-white" href="/sales"><i class="bi bi-cart-check me-1"></i>Sales</a><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-outline-light">Sign out</button></form></div></div></nav>
  <main class="container py-4 py-md-5">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3"><div><h1 class="h2 mb-1">Inventory overview</h1><p class="text-secondary mb-0">Manage products and available stock.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#productModal" id="newProduct"><i class="bi bi-plus-lg me-1"></i>Add product</button></div>
    <div class="row g-3 mb-4"><div class="col-4"><div class="card stat-card h-100 border-0 shadow-sm"><div class="card-body"><div class="stat-icon text-primary bg-primary-subtle"><i class="bi bi-grid"></i></div><div class="text-secondary small mt-3">Products</div><div class="fs-3 fw-bold"><%= stats.totalItems %></div></div></div></div><div class="col-4"><div class="card stat-card h-100 border-0 shadow-sm"><div class="card-body"><div class="stat-icon text-success bg-success-subtle"><i class="bi bi-boxes"></i></div><div class="text-secondary small mt-3">Units in stock</div><div class="fs-3 fw-bold"><%= stats.totalUnits %></div></div></div></div><div class="col-4"><div class="card stat-card h-100 border-0 shadow-sm"><div class="card-body"><div class="stat-icon text-info bg-info-subtle"><i class="bi bi-cash-stack"></i></div><div class="text-secondary small mt-3">Inventory value</div><div class="fs-3 fw-bold">$<%= (stats.totalValueCents / 100).toFixed(2) %></div></div></div></div></div>
    <% if (notice) { %><div class="alert alert-<%= notice.type %> alert-dismissible fade show" role="alert"><%= notice.message %><button class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
    <div class="card border-0 shadow-sm"><div class="card-body p-3 p-md-4"><form class="row g-2 mb-4" method="get"><div class="col-md"><div class="input-group"><span class="input-group-text bg-white"><i class="bi bi-search"></i></span><input class="form-control" name="q" value="<%= query %>" maxlength="120" placeholder="Search name or SKU"></div></div><div class="col-md-auto"><button class="btn btn-outline-primary w-100">Search</button></div></form>
      <% if (!products.length) { %><div class="text-center text-secondary py-5"><i class="bi bi-inboxes fs-1 d-block mb-2"></i>No products found.</div><% } else { %><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Product</th><th>In stock</th><th>Unit price</th><th>Value</th><th class="text-end">Actions</th></tr></thead><tbody><% products.forEach(product => { %><tr><td><div class="fw-semibold"><%= product.name %></div><small class="text-secondary font-monospace"><%= product.sku %></small></td><td class="fw-semibold"><%= product.qty %></td><td>$<%= product.price.toFixed(2) %></td><td class="fw-semibold">$<%= (product.qty * product.price).toFixed(2) %></td><td class="text-end text-nowrap"><button class="btn btn-sm btn-outline-primary edit-product" data-product="<%= encodeURIComponent(JSON.stringify(product)) %>"><i class="bi bi-pencil"></i></button> <form class="d-inline" method="post" action="/products/<%= product.id %>/delete" onsubmit="return confirm('Delete this product?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form></td></tr><% }) %></tbody></table></div><% } %></div></div>
  </main>
  <div class="modal fade" id="productModal" tabindex="-1"><div class="modal-dialog"><form class="modal-content" id="productForm" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="modal-header"><h2 class="modal-title fs-5" id="productModalTitle">Add product</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-8"><label class="form-label">Product name</label><input class="form-control" name="name" maxlength="120" required></div><div class="col-4"><label class="form-label">SKU</label><input class="form-control" name="sku" maxlength="32" pattern="[A-Za-z0-9][A-Za-z0-9._-]{0,31}" required></div><div class="col-6"><label class="form-label">Quantity</label><input class="form-control" name="qty" type="number" min="0" max="1000000000" step="1" value="0" required></div><div class="col-6"><label class="form-label">Unit price</label><div class="input-group"><span class="input-group-text">$</span><input class="form-control" name="price" type="number" min="0" max="999999999.99" step="0.01" value="0" required></div></div></div></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary">Save product</button></div></form></div></div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="/inventory.js"></script>
</body></html>
