<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Sales | Stockroom</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"><link href="/styles.css" rel="stylesheet"></head>
<body><nav class="navbar navbar-dark bg-primary shadow-sm"><div class="container py-1"><a class="navbar-brand fw-bold" href="/"><i class="bi bi-box-seam-fill me-2"></i>Stockroom</a><div class="d-flex gap-3"><a class="nav-link text-white" href="/">Inventory</a><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-outline-light">Sign out</button></form></div></div></nav>
  <main class="container py-4 py-md-5"><div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4"><div><h1 class="h2 mb-1">Record a sale</h1><p class="text-secondary mb-0">Stock is automatically reduced after each sale.</p></div><div class="text-md-end"><span class="text-secondary small d-block">Today's sales</span><span class="fs-4 fw-bold text-success">$<%= (todayTotalCents / 100).toFixed(2) %></span></div></div>
    <% if (notice) { %><div class="alert alert-<%= notice.type %> alert-dismissible fade show"><%= notice.message %><button class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
    <div class="row g-4"><div class="col-lg-5"><div class="card border-0 shadow-sm"><form method="post" action="/sale"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="card-body p-4"><h2 class="h5 mb-4">New sale</h2><% if (!products.length) { %><p class="text-secondary mb-0">There are no products available to sell.</p><% } else { %><label class="form-label" for="productId">Product</label><select class="form-select mb-3" id="productId" name="productId" required><option value="" selected disabled>Select a product</option><% products.forEach(product => { %><option value="<%= product.id %>" data-price="<%= product.price %>" data-stock="<%= product.qty %>"><%= product.name %> — <%= product.qty %> available</option><% }) %></select><label class="form-label" for="quantity">Quantity</label><input class="form-control" id="quantity" name="quantity" type="number" min="1" max="1000000000" step="1" value="1" required><div class="form-text" id="stockHint">Select a product to see available stock.</div><div class="sale-total rounded-3 p-3 mt-3"><span class="text-secondary small">Sale total</span><span class="fs-4 fw-bold" id="saleTotal">$0.00</span></div><button class="btn btn-primary w-100 mt-3">Complete sale</button><% } %></div></form></div></div><div class="col-lg-7"><div class="card border-0 shadow-sm"><div class="card-body p-3 p-md-4"><h2 class="h5 mb-3">Recent sales</h2><% if (!sales.length) { %><p class="text-secondary mb-0">No sales recorded yet.</p><% } else { %><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Product</th><th>Sold</th><th>When</th><th class="text-end">Total</th></tr></thead><tbody><% sales.forEach(sale => { %><tr><td><div class="fw-semibold"><%= sale.productName %></div><small class="font-monospace text-secondary"><%= sale.sku %></small></td><td><%= sale.quantity %> × $<%= sale.unit_price.toFixed(2) %></td><td class="text-secondary"><%= new Date(sale.sold_at).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) %></td><td class="text-end fw-semibold">$<%= sale.total.toFixed(2) %></td></tr><% }) %></tbody></table></div><% } %></div></div></div></div>
  </main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="/sales.js"></script></body></html>
